{
  "name": "nova-5.7-sol-desktop",
  "version": "5.7.0",
  "private": true,
  "description": "NOVA 5.7 Sol desktop client for NexusNova with local Ollama bridge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.nexusnova.nova57sol",
    "productName": "NOVA 5.7 Sol",
    "artifactName": "NOVA-5.7-Sol-Setup-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NOVA 5.7 Sol"
    }
  }
}
