rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function verifiedOwner(uid) {
      return owns(uid) && request.auth.token.email_verified == true;
    }

    function validCurrency(value) {
      return value == 'PKR' || value == 'USD' || value == 'EUR' || value == 'GBP';
    }

    function validProfileCreate(uid) {
      return request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'balance', 'totalMined', 'tasksCompleted',
          'completedTasks', 'miningActive', 'miningStartedAt',
          'miningLastUpdate', 'sessionEarned', 'lastDailyReward',
          'dailyRewardStreak', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'balance', 'totalMined', 'tasksCompleted',
          'completedTasks', 'miningActive', 'miningStartedAt',
          'miningLastUpdate', 'sessionEarned', 'lastDailyReward',
          'dailyRewardStreak', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.balance == 0
        && request.resource.data.totalMined == 0
        && request.resource.data.tasksCompleted == 0
        && request.resource.data.completedTasks is map
        && request.resource.data.completedTasks.size() == 0
        && request.resource.data.miningActive == false
        && request.resource.data.miningStartedAt == 0
        && request.resource.data.miningLastUpdate == 0
        && request.resource.data.sessionEarned == 0
        && request.resource.data.lastDailyReward == 0
        && request.resource.data.dailyRewardStreak == 0
        && request.resource.data.createdAt == request.time;
    }

    function validProfileNameEdit() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }

    function validProfileDetailsEdit() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'photoDataUrl', 'bio', 'city', 'country', 'profileUpdatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.get('photoDataUrl', '') is string
        && request.resource.data.get('photoDataUrl', '').size() <= 180000
        && (
          request.resource.data.get('photoDataUrl', '') == ''
          || request.resource.data.get('photoDataUrl', '').matches('^data:image/jpeg;base64,.*$')
        )
        && request.resource.data.get('bio', '') is string
        && request.resource.data.get('bio', '').size() <= 180
        && request.resource.data.get('city', '') is string
        && request.resource.data.get('city', '').size() <= 80
        && request.resource.data.get('country', '') is string
        && request.resource.data.get('country', '').size() <= 80
        && request.resource.data.profileUpdatedAt == request.time;
    }

    function freshMiningMillis(value) {
      return value is int
        && value >= request.time.toMillis() - 60000
        && value <= request.time.toMillis() + 60000;
    }

    function validMiningStart() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['miningActive', 'miningStartedAt', 'miningLastUpdate'])
        && resource.data.miningActive == false
        && resource.data.miningStartedAt == 0
        && request.resource.data.miningActive == true
        && freshMiningMillis(request.resource.data.miningStartedAt)
        && request.resource.data.miningLastUpdate == request.resource.data.miningStartedAt;
    }

    // Rewarded mining boosts deliberately do not touch balance/totalMined.
    // A valid boost shifts only the session start timestamp by exactly 2 hours.
    // miningLastUpdate is the immutable session-start anchor until finish, so
    // the rule can enforce a hard six-use / 12-hour maximum without trusting
    // client-maintained counters.
    function validMiningBoost() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['miningStartedAt'])
        && resource.data.miningActive == true
        && resource.data.miningStartedAt is int
        && resource.data.miningStartedAt > 0
        && resource.data.miningLastUpdate is int
        && resource.data.miningLastUpdate > 0
        && resource.data.miningStartedAt <= resource.data.miningLastUpdate
        && (
          resource.data.miningLastUpdate - resource.data.miningStartedAt == 0
          || resource.data.miningLastUpdate - resource.data.miningStartedAt == 7200000
          || resource.data.miningLastUpdate - resource.data.miningStartedAt == 14400000
          || resource.data.miningLastUpdate - resource.data.miningStartedAt == 21600000
          || resource.data.miningLastUpdate - resource.data.miningStartedAt == 28800000
          || resource.data.miningLastUpdate - resource.data.miningStartedAt == 36000000
        )
        && request.time.toMillis() - resource.data.miningStartedAt < 86400000
        && request.resource.data.miningStartedAt == resource.data.miningStartedAt - 7200000
        && request.resource.data.miningStartedAt >= resource.data.miningLastUpdate - 43200000;
    }

    function validMiningFinish() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'totalMined', 'miningActive', 'miningStartedAt', 'miningLastUpdate'])
        && resource.data.miningActive == true
        && resource.data.miningStartedAt is int
        && resource.data.miningStartedAt > 0
        && request.time.toMillis() - resource.data.miningStartedAt >= 86400000
        && resource.data.balance is number
        && resource.data.totalMined is number
        && request.resource.data.balance == resource.data.balance + 24
        && request.resource.data.totalMined == resource.data.totalMined + 24
        && request.resource.data.miningActive == false
        && request.resource.data.miningStartedAt == 0
        && freshMiningMillis(request.resource.data.miningLastUpdate);
    }

    function validMiningRollover() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'totalMined', 'miningActive', 'miningStartedAt', 'miningLastUpdate'])
        && resource.data.miningActive == true
        && resource.data.miningStartedAt is int
        && resource.data.miningStartedAt > 0
        && request.time.toMillis() - resource.data.miningStartedAt >= 86400000
        && resource.data.balance is number
        && resource.data.totalMined is number
        && request.resource.data.balance == resource.data.balance + 24
        && request.resource.data.totalMined == resource.data.totalMined + 24
        && request.resource.data.miningActive == true
        && freshMiningMillis(request.resource.data.miningStartedAt)
        && request.resource.data.miningLastUpdate == request.resource.data.miningStartedAt;
    }

    function validMiningRepair() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['miningActive', 'miningStartedAt', 'miningLastUpdate'])
        && (
          (resource.data.miningActive == true && resource.data.miningStartedAt == 0)
          || (resource.data.miningActive == false && resource.data.miningStartedAt != 0)
        )
        && request.resource.data.miningActive == false
        && request.resource.data.miningStartedAt == 0
        && freshMiningMillis(request.resource.data.miningLastUpdate);
    }

    function validDailyReward() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'lastDailyReward', 'dailyRewardStreak'])
        && resource.data.balance is number
        && resource.data.balance >= 0
        && resource.data.lastDailyReward is number
        && resource.data.lastDailyReward >= 0
        && resource.data.dailyRewardStreak is number
        && resource.data.dailyRewardStreak >= 0
        && request.time.toMillis() - resource.data.lastDailyReward >= 86400000
        && request.resource.data.balance == resource.data.balance + 5
        && freshMiningMillis(request.resource.data.lastDailyReward)
        && (
          (
            resource.data.lastDailyReward > 0
            && request.time.toMillis() - resource.data.lastDailyReward <= 172800000
            && request.resource.data.dailyRewardStreak == resource.data.dailyRewardStreak + 1
          )
          || (
            (
              resource.data.lastDailyReward == 0
              || request.time.toMillis() - resource.data.lastDailyReward > 172800000
            )
            && request.resource.data.dailyRewardStreak == 1
          )
        );
    }

    function leaderboardSource(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function validLeaderboardWrite(uid) {
      return request.resource.data.keys().hasAll([
          'name', 'totalMined', 'tasksCompleted', 'dailyRewardStreak', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'totalMined', 'tasksCompleted', 'dailyRewardStreak', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.totalMined is number
        && request.resource.data.totalMined >= 0
        && request.resource.data.tasksCompleted is number
        && request.resource.data.tasksCompleted >= 0
        && request.resource.data.dailyRewardStreak is number
        && request.resource.data.dailyRewardStreak >= 0
        && request.resource.data.name == leaderboardSource(uid).name
        && request.resource.data.totalMined == leaderboardSource(uid).totalMined
        && request.resource.data.tasksCompleted == leaderboardSource(uid).tasksCompleted
        && request.resource.data.dailyRewardStreak == leaderboardSource(uid).get('dailyRewardStreak', 0)
        && request.resource.data.updatedAt == request.time;
    }

    function userSource(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function validReferralCodeCreate(code) {
      return signedIn()
        && request.resource.data.keys().hasAll(['ownerUid','code','createdAt'])
        && request.resource.data.keys().hasOnly(['ownerUid','code','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.code is string
        && request.resource.data.code.matches('^NVX-[A-Z0-9]{8,16}$')
        && request.resource.data.createdAt == request.time;
    }

    function validReferralCreate(referredUid) {
      return owns(referredUid)
        && request.resource.data.keys().hasAll([
          'referredUid','referrerUid','code','status','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'referredUid','referrerUid','code','status','createdAt'
        ])
        && request.resource.data.referredUid == referredUid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != referredUid
        && request.resource.data.code is string
        && request.resource.data.code.matches('^NVX-[A-Z0-9]{8,16}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/referralCodes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.code)).data.ownerUid == request.resource.data.referrerUid
        && userSource(referredUid).createdAt is timestamp
        && request.time <= userSource(referredUid).createdAt + duration.value(24, 'h');
    }

    function validReferralVerify(referredUid) {
      return verifiedOwner(referredUid)
        && resource.data.referredUid == referredUid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','verifiedAt'])
        && request.resource.data.status == 'verified'
        && request.resource.data.verifiedAt == request.time
        && userSource(referredUid).totalMined is number
        && userSource(referredUid).totalMined >= 24;
    }

    function validChatMessage() {
      return request.resource.data.keys().hasAll([
          'uid', 'name', 'text', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'text', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    function validBugReportCreate(uid) {
      return owns(uid)
        && request.resource.data.keys().hasAll([
          'category','severity','description','feature','diagnosticsIncluded',
          'diagnostics','moduleVersion','status','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'category','severity','description','feature','diagnosticsIncluded',
          'diagnostics','moduleVersion','status','createdAt'
        ])
        && request.resource.data.category is string
        && (
          request.resource.data.category == 'ui'
          || request.resource.data.category == 'login'
          || request.resource.data.category == 'mining'
          || request.resource.data.category == 'wallet'
          || request.resource.data.category == 'tasks'
          || request.resource.data.category == 'market'
          || request.resource.data.category == 'search'
          || request.resource.data.category == 'profile'
          || request.resource.data.category == 'growth'
          || request.resource.data.category == 'other'
        )
        && request.resource.data.severity is string
        && (
          request.resource.data.severity == 'low'
          || request.resource.data.severity == 'medium'
          || request.resource.data.severity == 'high'
          || request.resource.data.severity == 'critical'
        )
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 15
        && request.resource.data.description.size() <= 2000
        && request.resource.data.feature is string
        && request.resource.data.feature.size() <= 50
        && request.resource.data.diagnosticsIncluded is bool
        && request.resource.data.diagnostics is string
        && request.resource.data.diagnostics.size() <= 1200
        && request.resource.data.moduleVersion == 'bug-report-v1'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }

    function validListingFields(data) {
      return data.sellerUid is string
        && data.sellerName is string && data.sellerName.size() > 0 && data.sellerName.size() <= 80
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 1200
        && data.category is string && data.category.size() > 0 && data.category.size() <= 60
        && data.price is number && data.price >= 0 && data.price <= 1000000000
        && validCurrency(data.currency)
        && (data.status == 'active' || data.status == 'sold' || data.status == 'hidden');
    }

    function validListingCreate() {
      return request.resource.data.keys().hasAll([
          'sellerUid','sellerName','title','description','category','price','currency','status','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'sellerUid','sellerName','title','description','category','price','currency','status','createdAt','updatedAt'
        ])
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validListingFields(request.resource.data);
    }

    function validListingUpdate() {
      return request.auth.uid == resource.data.sellerUid
        && request.resource.data.keys().hasAll([
          'sellerUid','sellerName','title','description','category','price','currency','status','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'sellerUid','sellerName','title','description','category','price','currency','status','createdAt','updatedAt'
        ])
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validListingFields(request.resource.data);
    }

    function orderListingExists() {
      return exists(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.listingId));
    }

    function validOrderCreate() {
      return request.resource.data.keys().hasAll([
          'listingId','buyerUid','sellerUid','title','amount','currency','status','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'listingId','buyerUid','sellerUid','title','amount','currency','status','createdAt','updatedAt'
        ])
        && request.resource.data.listingId is string
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.sellerUid is string
        && request.resource.data.sellerUid != request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000000
        && validCurrency(request.resource.data.currency)
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && orderListingExists()
        && get(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.listingId)).data.status == 'active'
        && get(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.listingId)).data.sellerUid == request.resource.data.sellerUid
        && get(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.listingId)).data.title == request.resource.data.title
        && get(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.listingId)).data.price == request.resource.data.amount
        && get(/databases/$(database)/documents/marketplaceListings/$(request.resource.data.listingId)).data.currency == request.resource.data.currency;
    }

    function sellerOrderTransitionAllowed() {
      return request.auth.uid == resource.data.sellerUid
        && (
          (resource.data.status == 'requested'
            && (request.resource.data.status == 'accepted' || request.resource.data.status == 'cancelled'))
          || (resource.data.status == 'accepted'
            && (request.resource.data.status == 'processing' || request.resource.data.status == 'cancelled'))
          || (resource.data.status == 'processing'
            && (request.resource.data.status == 'shipped' || request.resource.data.status == 'cancelled'))
          || (resource.data.status == 'shipped'
            && request.resource.data.status == 'out_for_delivery')
          || (resource.data.status == 'out_for_delivery'
            && request.resource.data.status == 'delivered')
        );
    }

    function buyerOrderTransitionAllowed() {
      return request.auth.uid == resource.data.buyerUid
        && (
          ((resource.data.status == 'requested' || resource.data.status == 'accepted')
            && request.resource.data.status == 'cancelled')
          || (resource.data.status == 'delivered'
            && request.resource.data.status == 'return_requested')
        );
    }

    function validOrderUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (sellerOrderTransitionAllowed() || buyerOrderTransitionAllowed());
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validProfileCreate(uid);
      allow update: if (owns(uid) && (validProfileNameEdit() || validProfileDetailsEdit()))
        || (verifiedOwner(uid) && (
          validMiningStart()
          || validMiningBoost()
          || validMiningFinish()
          || validMiningRollover()
          || validMiningRepair()
        ));
      allow delete: if false;
    }

    match /leaderboardPublic/{uid} {
      allow read: if signedIn();
      allow create, update: if verifiedOwner(uid) && validLeaderboardWrite(uid);
      allow delete: if false;
    }

    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if validReferralCodeCreate(code);
      allow update, delete: if false;
    }

    match /referrals/{referredUid} {
      allow read: if signedIn()
        && (request.auth.uid == referredUid || request.auth.uid == resource.data.referrerUid);
      allow create: if validReferralCreate(referredUid);
      allow update: if validReferralVerify(referredUid);
      allow delete: if false;
    }

    match /bugReports/{uid}/items/{reportId} {
      allow create: if validBugReportCreate(uid);
      allow read, update, delete: if false;
    }

    match /withdrawalRequests/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /chatMessages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.token.email_verified == true && validChatMessage();
      allow update, delete: if false;
    }

    match /marketplaceListings/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.token.email_verified == true && validListingCreate();
      allow update: if signedIn() && request.auth.token.email_verified == true && validListingUpdate();
      allow delete: if signedIn() && request.auth.token.email_verified == true && request.auth.uid == resource.data.sellerUid;
    }

    match /marketplaceOrders/{id} {
      allow read: if signedIn() && (request.auth.uid == resource.data.buyerUid || request.auth.uid == resource.data.sellerUid);
      allow create: if signedIn() && request.auth.token.email_verified == true && validOrderCreate();
      allow update: if signedIn() && request.auth.token.email_verified == true && validOrderUpdate();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
